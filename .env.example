# Server-only OpenRouter credentials. Never use NUXT_PUBLIC_ for these values.
NUXT_OPENROUTER_API_KEY=
NUXT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NUXT_OPENROUTER_SITE_URL=

# Server-only Honcho memory. Managed Honcho requires the API key.
NUXT_HONCHO_API_KEY=
NUXT_HONCHO_BASE_URL=https://api.honcho.dev
