# Server-only OpenRouter credentials. Never use NUXT_PUBLIC_ for these values.
NUXT_OPENROUTER_API_KEY=
NUXT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NUXT_OPENROUTER_SITE_URL=
NUXT_OPENROUTER_APP_NAME=Fabula

# The AI API fails closed until explicitly enabled.
NUXT_FABULA_AI_ENABLED=false

# This repository does not have account authentication yet. Set this only for a
# controlled local/demo environment behind your own access boundary.
NUXT_FABULA_AI_ALLOW_UNAUTHENTICATED=false

# Optional routes are independently gated.
NUXT_FABULA_AI_NEMOTRON_ENABLED=false
NUXT_FABULA_AI_AION_ENABLED=false
NUXT_FABULA_AI_MEDIA_ENABLED=false
NUXT_FABULA_AI_PREMIUM_MEDIA_ENABLED=false
NUXT_FABULA_AI_REQUESTS_PER_MINUTE=8
