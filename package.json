{
  "name": "fabula",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "honcho:build": "docker build -t fabula-honcho:3.0.11-4d3ab1c -f - https://github.com/plastic-labs/honcho.git#4d3ab1c36b4f805af02db3ef1feb1a049efe422f < infra/honcho/Dockerfile",
    "honcho:up": "bun run honcho:build && docker compose --env-file .env -f infra/honcho/compose.yml up -d --no-build",
    "honcho:status": "docker compose --env-file .env -f infra/honcho/compose.yml ps",
    "honcho:logs": "docker compose --env-file .env -f infra/honcho/compose.yml logs --tail=80 api deriver",
    "honcho:isolation": "bun scripts/honcho-isolation-smoke.ts",
    "preview": "nuxt preview",
    "test": "bun test server/ai server/game server/memory",
    "live:ai:text": "bun scripts/ai-live-smoke.ts",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/nuxt": "^14.4.0",
    "gsap": "^3.15.0",
    "nuxt": "4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.8"
  }
}
